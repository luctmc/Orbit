{
  "name": "orbit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "allowScripts": {
    "node-pty": true,
    "fsevents": false
  }
}
