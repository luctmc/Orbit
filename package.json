{
  "name": "orbit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "app": "npm run tauri -w @orbit/desktop -- dev",
    "app:build": "npm run tauri -w @orbit/desktop -- build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "release": "node scripts/release.mjs",
    "agent:setup": "git config core.hooksPath .githooks",
    "agent:begin": "node scripts/agent-flow.mjs begin",
    "agent:status": "node scripts/agent-flow.mjs status",
    "agent:finish": "node scripts/agent-flow.mjs finish",
    "test:workflow": "node --test scripts/*.test.mjs"
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true,
    "fsevents": false
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
